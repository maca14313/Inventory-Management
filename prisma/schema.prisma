// Multi-Tenant Enterprise IMS — Prisma Schema
// All models use Int @id @default(autoincrement()) (numeric ID contract).
// No Batch / BatchEntry models — Lot replaces them (Change 1 + Change 2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── 1. Enterprise ─────────────────────────────────────────
model Enterprise {
  id              Int      @id @default(autoincrement())
  name            String
  code            String   @unique
  contactEmail    String   @default("")
  contactPhone    String   @default("")
  address         String   @default("")
  isActive        Boolean  @default(true)
  maxBranches     Int      @default(10)
  maxWarehouses   Int      @default(50)
  maxUsers        Int      @default(100)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branches        Branch[]
  warehouses      Warehouse[]
  users           User[]
  categories      Category[]
  conditions      Condition[]
  suppliers       Supplier[]
  products        Product[]
  orders          Order[]
  features        Feature[]
  stockInRecorders StockInRecorder[]
  stockOutRecorders StockOutRecorder[]
  returnRecorders ReturnRecorder[]
  nonReturnableRecorders NonReturnableRecorder[]
  auditLogs       AuditLog[]
  lots            Lot[]
  attachments     Attachment[]
}

// ─── 2. Branch ─────────────────────────────────────────────
model Branch {
  id            Int      @id @default(autoincrement())
  enterpriseId  Int
  name          String
  code          String
  location      String   @default("")
  managerName   String   @default("")
  managerEmail  String   @default("")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enterprise    Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  warehouses    Warehouse[]
  users         User[]
  attachments   Attachment[]

  @@index([enterpriseId])
}

// ─── 3. Warehouse ──────────────────────────────────────────
model Warehouse {
  id            Int      @id @default(autoincrement())
  enterpriseId  Int
  branchId      Int
  name          String
  code          String
  location      String   @default("")
  capacity      Int      @default(1000)
  managerName   String   @default("")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enterprise    Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  branch        Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stock         Stock[]
  lots          Lot[]
  orders        Order[]
  stockInRecorders  StockInRecorder[]
  stockOutRecorders StockOutRecorder[]
  users         User[]
  orderItems    OrderItem[]
  stockInItems  StockInItem[]
  stockOutItems StockOutItem[]
  attachments   Attachment[]

  @@index([enterpriseId])
  @@index([branchId])
}

// ─── 4. User ───────────────────────────────────────────────
model User {
  id            Int      @id @default(autoincrement())
  enterpriseId  Int?
  branchId      Int?
  warehouseId   Int?
  username      String   @unique
  email         String   @default("")
  fullName      String
  role          String   // 'super_admin' | 'enterprise_admin' | 'branch_admin' | 'warehouse_admin'
  isActive      Boolean  @default(true)
  passwordHash  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enterprise    Enterprise? @relation(fields: [enterpriseId], references: [id], onDelete: SetNull)
  branch        Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  warehouse     Warehouse?  @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  orders        Order[]     @relation("OrderCreatedBy")
  auditLogs     AuditLog[]
  uploadedAttachments Attachment[] @relation("AttachmentUploadedBy")

  @@index([enterpriseId])
  @@index([branchId])
  @@index([warehouseId])
}

// ─── 5. Category ───────────────────────────────────────────
model Category {
  id            Int      @id @default(autoincrement())
  enterpriseId  Int
  name          String
  description   String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enterprise    Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  products      Product[]

  @@index([enterpriseId])
}

// ─── 5b. Condition ─────────────────────────────────────────
model Condition {
  id            Int      @id @default(autoincrement())
  enterpriseId  Int
  name          String
  description   String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enterprise    Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  stockInItems  StockInItem[]
  stockOutItems StockOutItem[]
  lots          Lot[]

  @@index([enterpriseId])
}

// ─── 6. Supplier ───────────────────────────────────────────
model Supplier {
  id            Int      @id @default(autoincrement())
  enterpriseId  Int
  name          String
  contactPerson String   @default("")
  email         String   @default("")
  phone         String   @default("")
  address       String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enterprise    Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@index([enterpriseId])
}

// ─── 7. Product ────────────────────────────────────────────
model Product {
  id            Int      @id @default(autoincrement())
  enterpriseId  Int
  name          String
  sku           String   @unique
  description   String   @default("")
  categoryId    Int?
  price         Float    @default(0)
  cost          Float    @default(0)
  unit          String   @default("piece")
  reorderLevel  Int      @default(10)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enterprise    Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  category      Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stock         Stock[]
  lots          Lot[]
  orderItems    OrderItem[]
  stockInItems  StockInItem[]
  stockOutItems StockOutItem[]

  @@index([enterpriseId])
  @@index([categoryId])
}

// ─── 8. Stock ──────────────────────────────────────────────
model Stock {
  id            Int      @id @default(autoincrement())
  productId     Int
  warehouseId   Int
  quantity      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@index([productId])
}

// ─── 9. Lot (Change 2 — real lot tracking) ────────────────
model Lot {
  id            Int      @id @default(autoincrement())
  lotNumber     String   @unique
  productId     Int
  warehouseId   Int
  enterpriseId  Int
  quantity      Int      // original received
  remainingQty  Int      // current remaining (FIFO-decremented)
  unit          String   @default("piece")
  costPerUnit   Float    @default(0)
  supplierName  String?
  source        String   // 'stock_in' | 'register_item' | 'adjustment'
  sourceRef     String?
  notes         String?
  conditionId   Int?
  receivedDate  DateTime @default(now())
  closedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  enterprise    Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  condition     Condition? @relation(fields: [conditionId], references: [id], onDelete: SetNull)

  @@index([productId, warehouseId])
  @@index([enterpriseId])
  @@index([source])
  @@index([sourceRef])
  @@index([conditionId])
}

// ─── 10. Order ─────────────────────────────────────────────
model Order {
  id            Int      @id @default(autoincrement())
  enterpriseId  Int
  type          String   // 'purchase' | 'sales'
  supplierId    Int?
  warehouseId   Int?
  status        String   // 'pending' | 'approved' | 'shipped' | 'received' | 'cancelled'
  totalAmount   Float    @default(0)
  notes         String   @default("")
  createdBy     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enterprise    Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  supplier      Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  createdByUser User?      @relation("OrderCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  items         OrderItem[]

  @@index([enterpriseId])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([createdBy])
}

// ─── 11. OrderItem ─────────────────────────────────────────
model OrderItem {
  id            Int      @id @default(autoincrement())
  orderId       Int
  productId     Int
  warehouseId   Int
  quantity      Int      @default(0)
  unitPrice     Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@index([warehouseId])
}

// ─── 12. StockInRecorder ───────────────────────────────────
model StockInRecorder {
  id            Int      @id @default(autoincrement())
  enterpriseId  Int
  warehouseId   Int
  recorderCode  String   @unique  // SIN-YYYY-NNNN
  personName    String   @default("")
  personPhone   String   @default("")
  personEmail   String   @default("")
  personAddress String   @default("")
  notes         String   @default("")
  status        String   @default("pending")  // 'pending' | 'submitted'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enterprise    Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  warehouse     Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  items         StockInItem[]

  @@index([enterpriseId])
  @@index([warehouseId])
}

// ─── 13. StockInItem ───────────────────────────────────────
model StockInItem {
  id            Int      @id @default(autoincrement())
  recorderId    Int
  productId     Int
  warehouseId   Int
  quantity      Int      @default(0)
  unit          String   @default("piece")
  costPerUnit   Float    @default(0)
  notes         String   @default("")
  conditionId   Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  recorder      StockInRecorder @relation(fields: [recorderId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse     Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  condition     Condition?      @relation(fields: [conditionId], references: [id], onDelete: SetNull)

  @@index([recorderId])
  @@index([productId])
  @@index([warehouseId])
  @@index([conditionId])
}

// ─── 14. StockOutRecorder ──────────────────────────────────
model StockOutRecorder {
  id            Int      @id @default(autoincrement())
  enterpriseId  Int
  warehouseId   Int
  recorderCode  String   @unique  // SOUT-YYYY-NNNN
  personName    String   @default("")
  personPhone   String   @default("")
  personEmail   String   @default("")
  personAddress String   @default("")
  notes         String   @default("")
  status        String   @default("pending")  // 'pending' | 'partial_return' | 'returned'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enterprise    Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  warehouse     Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  items         StockOutItem[]

  @@index([enterpriseId])
  @@index([warehouseId])
}

// ─── 15. StockOutItem ──────────────────────────────────────
model StockOutItem {
  id            Int      @id @default(autoincrement())
  recorderId    Int
  productId     Int
  warehouseId   Int
  quantity      Int      @default(0)
  unit          String   @default("piece")
  isReturnable  Boolean  @default(false)
  returnDeadline DateTime?
  notes         String   @default("")
  conditionId   Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  recorder      StockOutRecorder @relation(fields: [recorderId], references: [id], onDelete: Cascade)
  product       Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse     Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  condition     Condition?       @relation(fields: [conditionId], references: [id], onDelete: SetNull)
  returns       Return[]
  nonReturnables NonReturnable[]

  @@index([recorderId])
  @@index([productId])
  @@index([warehouseId])
  @@index([isReturnable])
  @@index([conditionId])
}

// ─── 15b. ReturnRecorder (a first-class record for a group return — mirrors StockInRecorder) ──
model ReturnRecorder {
  id            Int      @id @default(autoincrement())
  enterpriseId  Int
  recorderCode  String   @unique  // RET-YYYY-NNNN
  personName    String   @default("")
  personPhone   String   @default("")
  personEmail   String   @default("")
  personAddress String   @default("")
  notes         String   @default("")
  status        String   @default("completed")  // group returns are processed immediately
  itemCount     Int      @default(0)
  totalQty      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enterprise    Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  returns       Return[]

  @@index([enterpriseId])
}

// ─── 15c. Return (tracks each return transaction against a StockOutItem) ──
model Return {
  id                Int      @id @default(autoincrement())
  stockOutItemId    Int
  returnRecorderId  Int?
  quantity          Int      @default(0)
  unit              String   @default("piece")
  notes             String   @default("")
  returnedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  stockOutItem   StockOutItem    @relation(fields: [stockOutItemId], references: [id], onDelete: Cascade)
  returnRecorder ReturnRecorder? @relation(fields: [returnRecorderId], references: [id], onDelete: SetNull)

  @@index([stockOutItemId])
  @@index([returnRecorderId])
}

// ─── 15d. NonReturnableRecorder (a first-class record for a group "mark as non-returnable"
//    decision — mirrors ReturnRecorder exactly so the UX parallels the Returns feature) ──
model NonReturnableRecorder {
  id            Int      @id @default(autoincrement())
  enterpriseId  Int
  recorderCode  String   @unique  // NR-YYYY-NNNN
  personName    String   @default("")
  personPhone   String   @default("")
  personEmail   String   @default("")
  personAddress String   @default("")
  notes         String   @default("")
  status        String   @default("completed")  // group decisions are processed immediately
  itemCount     Int      @default(0)
  totalQty      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enterprise    Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  nonReturnables NonReturnable[]

  @@index([enterpriseId])
}

// ─── 15e. NonReturnable (tracks each "this item cannot be returned" decision against a
//    StockOutItem, with a reason chosen from a fixed catalogue — mirrors Return) ──
model NonReturnable {
  id                       Int      @id @default(autoincrement())
  stockOutItemId           Int
  nonReturnableRecorderId  Int?
  quantity                 Int      @default(0)
  unit                     String   @default("piece")
  reason                   String   // one of the NON_RETURNABLE_REASONS keys (e.g. "damaged")
  reasonDetail             String   @default("")  // free-text note when reason="other"
  notes                    String   @default("")  // additional operator notes
  decidedAt                DateTime @default(now())
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  stockOutItem          StockOutItem           @relation(fields: [stockOutItemId], references: [id], onDelete: Cascade)
  nonReturnableRecorder NonReturnableRecorder? @relation(fields: [nonReturnableRecorderId], references: [id], onDelete: SetNull)

  @@index([stockOutItemId])
  @@index([nonReturnableRecorderId])
  @@index([reason])
}

// ─── 16. AuditLog ──────────────────────────────────────────
model AuditLog {
  id            Int      @id @default(autoincrement())
  userId        Int?
  enterpriseId  Int?
  action        String
  entity        String
  entityId      Int?
  details       String   @default("")
  createdAt     DateTime @default(now())

  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  enterprise    Enterprise? @relation(fields: [enterpriseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([enterpriseId])
  @@index([entity])
}

// ─── 17. Feature ───────────────────────────────────────────
model Feature {
  id            Int      @id @default(autoincrement())
  enterpriseId  Int
  feature       String
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enterprise    Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  @@unique([enterpriseId, feature])
  @@index([enterpriseId])
}

// ─── 18. Attachment ────────────────────────────────────────
// A file (any type) or a bundle of files stored as a ZIP archive on disk.
// Can be standalone (entityType='standalone', entityId=null) OR linked to ANY record
// or even an individual line-item:
//   'standalone' | 'stock_in' | 'stock_in_item' | 'stock_out' | 'stock_out_item'
//   | 'return' | 'non_returnable' | 'order' | 'order_item' | 'product'
// Supports unlimited custom metadata key-value-description fields (AttachmentMeta).
// Tenant-isolated: never crosses enterprise/branch/warehouse boundaries.
model Attachment {
  id            Int      @id @default(autoincrement())
  enterpriseId  Int
  branchId      Int?
  warehouseId   Int?
  fileName      String   // primary file name (first file, or zip name for multi-file)
  storedName    String   // on-disk ZIP file name (e.g. "att_1700000000_abc.zip")
  mimeType      String   // primary mime type (first file's mime)
  originalSize  Int      // total bytes before compression (sum of all files)
  storedSize    Int      // bytes after zip compression
  isImage       Boolean  @default(false)  // true if primary file is an image
  isMultiFile   Boolean  @default(false)  // true if archive contains >1 file
  fileCount     Int      @default(1)      // number of files inside the zip
  fileCategory  String   @default("other") // 'image' | 'pdf' | 'document' | 'spreadsheet' | 'presentation' | 'archive' | 'video' | 'audio' | 'code' | 'other'
  fileListJson  String   @default("[]")   // JSON array of [{name,size,mimeType}] for zip contents
  previewData   String   @default("")     // reserved (legacy); previews served via inline download
  entityType    String   @default("standalone")
  entityId      Int?
  title         String   @default("")
  description   String   @default("")
  uploadedById  Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enterprise    Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  branch        Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  uploadedBy    User?      @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  metaFields    AttachmentMeta[]

  @@index([enterpriseId])
  @@index([branchId])
  @@index([warehouseId])
  @@index([entityType, entityId])
  @@index([uploadedById])
  @@index([isImage])
  @@index([fileCategory])
}

// ─── 19. AttachmentMeta ────────────────────────────────────
// Custom key-value-description metadata attached to an attachment. Unlimited count.
model AttachmentMeta {
  id            Int      @id @default(autoincrement())
  attachmentId  Int
  key           String
  value         String   @default("")
  description   String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  attachment    Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@index([attachmentId])
  @@index([key])
}
