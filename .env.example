# ─── Inventory Management — environment template ───
# With the TERMINAL method (DEPLOY-TERMINAL.md) you may export these in the
# shell before `nohup node app.js …`, or set them in cPanel if the Node.js
# App extension exists. Do NOT create a .env file on the server.

# SQLite database file (relative to the app root, or absolute).
# Created + migrated + seeded automatically on first app start.
DB_PATH=db/custom.db

# App mode
NODE_ENV=production

# Internal port behind the .htaccess reverse proxy (terminal method).
# Keep it in sync with the port in public_html/.htaccess.
# PORT=3001

# Optional: serve the app under a sub-path (omit for root deploys)
# BASE_PATH=/inventory

# Optional: token/session salting — generate locally with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# APP_SECRET=change-me
