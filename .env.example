# ─── Inventory Management — environment template (deployment-guide §10) ───
# Copy values into cPanel's "Setup Node.js App → Environment Variables".
# Do NOT create a .env file on the server — Passenger injects env vars.

# SQLite database file (relative to the app root, or absolute).
# Created + migrated + seeded automatically on first app start.
DB_PATH=db/custom.db

# App mode (cPanel sets this too, but set it to be safe)
NODE_ENV=production

# Optional: serve the app under a sub-path (omit for root deploys)
# BASE_PATH=/inventory

# Optional: token/session salting — generate locally with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# APP_SECRET=change-me
